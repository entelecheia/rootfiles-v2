    {
      "dot": "cyan",
      "title": "Check and apply",
      "items": [
        "10 modules in a fixed defaultOrder; RunAll runs Check then Apply",
        "5 embedded profiles: minimal, base, full, gpu-server, dgx",
        "apt operations wrapped by internal/exec with dry-run respected"
      ]
    },
    {
      "dot": "violet",
      "title": "GPU allocation",
      "items": [
        "gpu module keeps allocations in <home-base>/.rootfiles/gpu-allocations.json",
        "syscall.Flock LOCK_EX plus tmp-and-rename serializes concurrent assign and revoke",
        "rootfiles gpu assign/revoke call the gpu module directly; RunAll re-applies env, cgroup and Docker wrapper"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tunnel and reporting",
      "items": [
        "cloudflared module installs daemon plus systemd vlan network units",
        "rootfiles tunnel update --check compares installed and upstream cloudflared without downloading",
        "internal/ui renders styled status sections with stable marks"
      ]
    }
